# Copy to the project root as .env for Docker Compose; Uvicorn uses exported shell variables.
SECRET_KEY=replace-with-a-long-random-secret-of-at-least-32-characters
DATABASE_URL=sqlite:///./diet_planner.db
STORAGE_BACKEND=local
STORAGE_DIR=./data/objects
CORS_ORIGINS=http://localhost:5173
# For managed PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST:5432/DB?sslmode=require
# For S3 or R2: STORAGE_BACKEND=s3, S3_BUCKET, S3_ENDPOINT_URL, S3_REGION,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY. All files are private.
# Optional: AI_API_URL=https://.../v1/chat/completions; AI_API_KEY=...; AI_MODEL=...
