# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite:///./plantcare.db
APP_ENV=development
ALLOW_REGISTRATION=true
MAX_PUBLIC_USERS=500
DATABASE_SCHEMA=plantcare
# On Render/Railway: APP_ENV=production, a PostgreSQL DATABASE_URL and random JWT_SECRET.
# PUBLIC_URL=https://your-actual-domain.example (optional origin validation override)
# Cloud example: postgresql+psycopg://user:password@host:5432/postgres?sslmode=require
# Use provider CA and sslmode=verify-full for certificate and hostname verification.
# Never commit .env, a real database URL, or .demo-credentials.json.
